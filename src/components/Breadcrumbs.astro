---
interface Crumb {
  href?: string;
  label: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> / </span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
    </>
  ))}
</nav>

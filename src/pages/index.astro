---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURES, GUIDES, COMPARES, PRICING, playUrl } from '../data/site';
const pageSlug = 'home';
const trust = [
  { k: 'No account', v: 'Open the app and create a vault. No email, no phone number.' },
  { k: 'No automatic upload', v: 'The app does not upload vault content to us and has no built-in cloud sync. There is no Vireault server holding your files.' },
  { k: 'Modern cryptography', v: 'Argon2id derives the key; AES-256-GCM seals every file.' },
  { k: 'Free to start', v: `${PRICING.free.vaults} vault and ${PRICING.free.items} items at no cost.` },
];
const steps = [
  { n: '1', t: 'Choose how you unlock', d: 'Set a PIN, draw a 3×3 or 5×5 pattern, or type a passphrase. Argon2id protects the key that unlocks a random vault master key. Compatible devices can enable fingerprint unlock after an unlock with your secret.' },
  { n: '2', t: 'Bring in your media', d: 'Pick photos, videos, audio or PDFs. Each one is encrypted as it enters the vault, and you can remove the original from your gallery afterwards.' },
  { n: '3', t: 'Close it and it locks', d: 'Switch apps or leave the phone idle for five minutes and the vault seals itself. Screenshots of vault screens are blocked.' },
];
const faqs = [
  { q: 'Can Vireault reset my PIN if I forget it?', a: 'We cannot reset it for you. If you set up and retain your user-held 12-word recovery phrase, you can use it to choose a new unlock secret. Skipping setup means a forgotten secret can permanently lock you out. Separate encrypted backups need their own recovery material.' },
  { q: 'Does it upload anything?', a: 'The app does not upload vault content to us and has no built-in cloud sync. You can deliberately export files or encrypted backups to a destination you choose. Purchases use Google Play Billing.' },
  { q: 'What is free and what is Pro?', a: `Free covers ${PRICING.free.vaults} vault and ${PRICING.free.items} items. Pro is ${PRICING.weekly}, ${PRICING.annual} with a ${PRICING.annualTrial}, or ${PRICING.lifetime} once for lifetime.` },
  { q: 'Can I move my vault to a new phone?', a: 'Export an encrypted backup, transfer it yourself, and restore it using that backup\'s recovery material. Keep that material separately and safely.' },
  { q: 'Does it have folders, fingerprint unlock or a decoy vault?', a: 'The current build supports folders, encrypted notes, compatible-device fingerprint unlock, in-app photo/video capture, and Pro hidden-list / decoy use. Cloud sync is not built in. Hidden mode is not forensic-proof.' },
];
---
<BaseLayout
  title="Vireault — Encrypted photo and file vault for Android"
  description="Vireault is an offline Android vault for photos, videos and files. Argon2id + AES-256-GCM, no account, PIN/pattern/passphrase unlock."
  path="/"
  pageSlug={pageSlug}
>
  <section class="hero-wrap">
  <div class="container hero">
    <div class="hero-copy">
      <p class="pill"><span class="pill-dot"></span> Argon2id · AES-256-GCM · No account</p>
      <h1>Hiding a photo isn't<br /><u>protecting it</u>.<br /><span class="h1-accent">Vireault seals it.</span></h1>
      <p class="lead lead-bar"><strong>Photos, videos and files locked with a key only you hold.</strong><br />Encrypted on your Android phone. No sign-up, no cloud, no email.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-xl" href={playUrl('home-hero')}>Get it on Google Play</a>
      </div>
      <div class="qr-card">
        <img src="/images/download-qr.svg" width="96" height="96" alt="QR code to download Vireault" />
        <div><strong>Scan to download on Android</strong><span>Point your phone camera at the code to open the download page.</span><a href="/#how-it-works">See how it works →</a></div>
      </div>
      <p class="note mini-facts"><span>Free: {PRICING.free.vaults} vault · {PRICING.free.items} items</span><span>Pro from {PRICING.weekly}</span><span>No automatic vault upload</span></p>
    </div>
    <div class="hero-media phone">
      <div class="phone-frame"><img src="/images/hero-pattern.webp" width="720" height="1600" alt="Vireault's real Android lock screen with a 5×5 pattern pad" fetchpriority="high" /></div>
    </div>
  </div>
  </section>

  <section class="ribbon" aria-label="Promises">
    <div class="container ribbon-inner"><span>✕ No accounts</span><span>✕ No cloud upload</span><span>✕ No back doors</span></div>
  </section>

  <section class="trust-strip" aria-label="Why people trust Vireault">
    <div class="container trust-grid">
      {trust.map((t) => (<div class="trust-item"><strong>{t.k}</strong><span>{t.v}</span></div>))}
    </div>
  </section>

  <section class="container section" id="features">
    <h2 class="center-h">What does a real<br />encrypted vault do?</h2>
    <p class="section-intro center">Vault contents and their index are encrypted at rest. Video recording needs a temporary app-private plaintext spool while recording; unfinished recordings are discarded when the app backgrounds or the vault locks. Six capabilities, each explained on its own page.</p>
    <div class="grid cols-3">
      {FEATURES.map((f) => (
        <a class="card card-click" href={f.href}>
          <h3>{f.title}</h3>
          <p>{f.short}</p>
          <span class="card-link">Read more →</span>
        </a>
      ))}
    </div>
    <p><a class="card-link" href="/features">Browse all features →</a></p>
  </section>

  <section class="section-alt" id="how-it-works">
    <div class="container section">
      <h2>How it works</h2>
      <p class="section-intro">From install to locked vault in about a minute.</p>
      <ol class="steps">
        {steps.map((s) => (<li class="step"><span class="step-n">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="container section split" id="security">
    <div>
      <h2>The security model, in plain words</h2>
      <ul class="checks">
        <li>Your secret is never stored. Argon2id turns it into a key each time you unlock.</li>
        <li>A random master key encrypts file contents with AES-256-GCM, which also detects tampering.</li>
        <li>The index is encrypted too, so file names and thumbnails are unreadable on disk.</li>
        <li>Repeated wrong attempts trigger a lockout delay.</li>
        <li>Backups are exported as encrypted files protected by their own recovery material.</li>
      </ul>
      <p><a class="card-link" href="/security">Read the full security model →</a> · <a class="card-link" href="/features/encryption">Encryption feature →</a></p>
    </div>
    <div class="shot-pair">
      <img src="/images/screenshot-unlock.png" alt="Vireault unlock screen" width="720" height="1280" loading="lazy" />
      <img src="/images/screenshot-security.png" alt="Vireault security settings" width="720" height="1280" loading="lazy" />
    </div>
  </section>

  <section class="container">
    <aside class="cta-band big">
      <h2>If someone picks up your phone, your gallery shows nothing private.</h2>
      <p>Move what matters into Vireault and it stays encrypted until you unlock it.</p>
      <p><a class="btn btn-primary" href={playUrl('home-mid')}>Get it on Google Play</a></p>
    </aside>
  </section>

  <section class="container section">
    <h2>Straight about what is here, and what is not</h2>
    <p class="section-intro">We would rather tell you up front than surprise you after install.</p>
    <div class="grid cols-2">
      <article class="card"><h3>Local features and honest limits</h3><p>Folders, notes, fingerprint unlock, recovery phrases, camera capture and Pro hidden / decoy vault use are implemented. Cloud sync is not built in. See the security page for limits, including temporary video storage and hidden mode.</p></article>
      <article class="card"><h3>Pricing</h3><p>Free: {PRICING.free.vaults} vault, {PRICING.free.items} items. Pro: {PRICING.weekly}, {PRICING.annual} ({PRICING.annualTrial}) or {PRICING.lifetime} lifetime.</p><a class="card-link" href="/pricing">Compare plans →</a></article>
    </div>
  </section>

  <section class="section-alt">
    <div class="container section">
      <h2>How Vireault stacks up</h2>
      <p class="section-intro">Side-by-side looks at popular Android hiding and vault apps.</p>
      <div class="grid cols-3">
        {COMPARES.map((c) => (<a class="card card-click" href={c.href}><h3>{c.title}</h3><p>{c.short}</p><span class="card-link">See comparison →</span></a>))}
      </div>
      <p><a class="btn btn-secondary" href="/compare">All comparisons</a></p>
    </div>
  </section>

  <section class="container section">
    <h2>Guides</h2>
    <p class="section-intro">Practical, step-by-step help with Android privacy.</p>
    <div class="grid cols-3">
      {GUIDES.slice(0, 3).map((g) => (<a class="card card-click" href={g.href}><h3>{g.title}</h3><p>{g.description}</p><span class="card-link">Read guide →</span></a>))}
    </div>
    <p><a class="card-link" href="/guides">All guides →</a></p>
  </section>

  <section class="container section faq" id="faq">
    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    <p><a class="card-link" href="/faq">More answers →</a></p>
  </section>
</BaseLayout>

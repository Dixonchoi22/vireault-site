---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import { FEATURES } from '../../data/site';
const pageSlug = 'features';
---
<BaseLayout
  title="Features"
  description="Explore Vireault features: AES-256 encryption, offline storage, PIN/pattern/passphrase unlock, multiple vaults, media import and encrypted backups."
  path="/features"
  pageSlug={pageSlug}
>
  <div class="container">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'Features' }]} />
    <section class="section">
      <h1>Features</h1>
      <p class="section-intro">Shipping capabilities are listed below. The current build also includes folders, notes, 5×5 patterns, fingerprint unlock on compatible devices, recovery phrases, in-app camera capture, and Pro hidden/decoy vaults and alternate icons. Cloud sync is not built in.</p>
      <div class="grid cols-2">
        {FEATURES.map((f) => (
          <article class="card">
            <h2 style="font-size:1.2rem;margin:0 0 0.5rem">{f.title}</h2>
            <p>{f.short}</p>
            <a class="card-link" href={f.href}>Open feature page →</a>
          </article>
        ))}
      </div>
    </section>
    <Cta pageSlug={pageSlug} />
  </div>
</BaseLayout>

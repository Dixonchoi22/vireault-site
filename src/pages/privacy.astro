---
// The published privacy policy lives at /privacy.html (unchanged legacy page). This path just forwards to it.
import { SITE } from '../data/site';
const target = `${SITE.domain}/privacy.html`;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Privacy policy | Vireault</title>
<meta name="robots" content="noindex" /><link rel="canonical" href={target} />
<meta http-equiv="refresh" content={`0; url=${target}`} /></head>
<body><p><a href={target}>Privacy policy</a></p></body></html>
